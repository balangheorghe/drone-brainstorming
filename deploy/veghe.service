# Alternativă fără Docker. Pașii completi: docs/13-implementare-deploy.md (secțiunea systemd).
# Pe scurt: repo-ul în /opt/veghe, utilizatorul `veghe`, config.toml și .env în /opt/veghe,
#   sudo mkdir -p /opt/veghe/data && sudo chown veghe:veghe /opt/veghe/data   (singurul director scris)
#   sudo cp deploy/veghe.service /etc/systemd/system/ && sudo systemctl enable --now veghe
# Necesită /usr/bin/python3 ≥ 3.11 (altfel schimbați ExecStart).
[Unit]
Description=veghe - avertizare timpurie OSINT pentru drone
After=network-online.target
Wants=network-online.target

[Service]
User=veghe
WorkingDirectory=/opt/veghe
EnvironmentFile=/opt/veghe/.env
ExecStart=/usr/bin/python3 -m veghe --config /opt/veghe/config.toml run
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veghe/data
PrivateTmp=true
PrivateDevices=true
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
