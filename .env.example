# Copiați în .env (NU îl puneți în git). Lăsați gol ce nu aveți încă.

# Ucraina – API-uri de alertă (cereri: https://alerts.in.ua/api-request și https://api.ukrainealarm.com)
ALERTS_IN_UA_TOKEN=
UKRAINEALARM_TOKEN=

# Telegram – bot creat cu @BotFather; ID-urile de chat ale grupurilor (încep cu -100...)
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_CHAT_ID=
# Canal public: doar retransmiteri oficiale, după aprobare. Lăsați gol la început.
TELEGRAM_PUBLIC_CHAT_ID=
# ID-urile numerice ale operatorilor care pot da comenzi (/aproba, /roalert), separate prin virgulă
TELEGRAM_OPERATOR_IDS=

# Opțional: notificări push prin ntfy (găzduit propriu)
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
